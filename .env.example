# Copy to .env. The real file is gitignored and never leaves this host.
#
# Generate each of the three secrets below with:
#
#   python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# This command is spelled out because "generate a 32-byte key" is exactly where people
# paste a short memorable string and silently lose the security property. The service
# validates length at startup and refuses to serve the affected routes if it is wrong,
# but it cannot tell a weak key from a strong one.

# Signs access-token JWTs. Rotating this logs everyone out (intentionally).
WEFT_JWT_SECRET=

# Signs CSRF double-submit tokens. Separate from the JWT secret on purpose — one key,
# one job, so a leak of either has a bounded blast radius.
WEFT_CSRF_SECRET=

# Encrypts provider bearer tokens at rest (AES-256-GCM).
#
# LOSE THIS AND THE VAULT IS GONE. There is no recovery path — that is what
# encryption at rest means. Back it up somewhere that is not this host.
WEFT_VAULT_KEY=

# Decrypt-only keys kept during a rotation, as "key_id:base64,key_id:base64".
# Leave blank until you actually rotate.
WEFT_VAULT_OLD_KEYS=

# ---------------------------------------------------------------------------
# First boot only.
#
# If BOTH are set, that owner account is created on first boot with
# must_change_password set. If EITHER is blank, the service generates a password and
# writes it to data/BOOTSTRAP.txt (mode 0600) as well as logging it once at WARNING.
#
# Bootstrap only runs when the users table is empty, so these go inert once the owner
# exists — the service warns if it finds them still set. Clear them afterwards.
# ---------------------------------------------------------------------------
WEFT_BOOTSTRAP_OWNER=
WEFT_BOOTSTRAP_PASSWORD=

# Logging. DEBUG is safe — no secret is ever passed to the logger (enforced by
# tests/test_no_secret_logging.py), but DEBUG is noisy.
LOG_LEVEL=INFO
